<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Task 8 deprecation pass (ruling 6): this template keeps its grain{} demo running
         beside its functional-runtime twin (CounterGrainFunctional.fs) on purpose. Flipping
         the template default is a later product decision. -->
    <NoWarn>$(NoWarn);FS0044</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CounterGrain.fs" />
    <Compile Include="CounterGrainFunctional.fs" />
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Orleans.FSharp" Version="4.*" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
  </ItemGroup>

</Project>
