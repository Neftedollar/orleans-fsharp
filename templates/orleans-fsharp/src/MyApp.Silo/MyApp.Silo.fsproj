<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Task 8 deprecation pass (ruling 6): this template keeps its AddFSharpGrain registration
         running beside its functional-runtime twin (AddFunctionalGrain) on purpose. -->
    <NoWarn>$(NoWarn);FS0044</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Orleans.FSharp" Version="3.*" />
    <PackageReference Include="Orleans.FSharp.Runtime" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyApp.Grains\MyApp.Grains.fsproj" />
    <ProjectReference Include="..\MyApp.CodeGen\MyApp.CodeGen.csproj" />
  </ItemGroup>

</Project>
