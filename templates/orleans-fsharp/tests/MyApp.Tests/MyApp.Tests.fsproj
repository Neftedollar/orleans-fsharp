<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Task 8 deprecation pass (ruling 6): these tests assert on the grain{} demo definition
         (CounterGrainDef.counter), which is [<Obsolete>] beside its functional-runtime twin.
         Same suppression as MyApp.Grains / MyApp.Silo, for the same reason. -->
    <NoWarn>$(NoWarn);FS0044</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CounterTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" Version="3.3.3" />
    <PackageReference Include="Unquote" Version="7.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyApp.Grains\MyApp.Grains.fsproj" />
  </ItemGroup>

</Project>
