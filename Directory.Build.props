<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/Versions.props"
          Condition="'$(OrleansSharedVersionsImported)' != 'true'" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A single checkout can verify the support floor and newest Orleans sequentially without
         reusing stale generated serializers or project.assets.json from the other version. -->
    <BaseIntermediateOutputPath>obj/$(OrleansVersion)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(OrleansVersion)/</BaseOutputPath>
    <!-- Once BaseIntermediateOutputPath is versioned, the SDK only excludes that one subtree.
         Keep every historical/default output subtree out of wildcard Compile/Content items too. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Versioning is driven by MinVer from git tags (tag prefix "v", see
         MinVerTagPrefix below). To cut a release: `git tag v5.0.0 && git push
         origin v5.0.0` — CI's publish job fires only on v5.* tag pushes, so a plain
         merge to main never publishes. Between tags MinVer emits a pre-release
         version for local/dev packs, which is expected. Release-candidate validation
         uses MinVerVersionOverride without creating or pushing a release tag. -->
    <Authors>Orleans.FSharp Contributors</Authors>
    <Description>Idiomatic F# API for Microsoft Orleans</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Neftedollar/orleans-fsharp</PackageProjectUrl>
    <PackageTags>fsharp;orleans;actors;virtual-actors;grains;silo;distributed;distributed-systems;actor-model;computation-expressions;event-sourcing;streaming;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/Neftedollar/orleans-fsharp</RepositoryUrl>
    <!-- Each packable project ships its own per-project README.md (PackageReadmeFile in
         its .fsproj/.csproj) — more useful on nuget.org than a shared one. -->
    <PackageReleaseNotes>See https://github.com/Neftedollar/orleans-fsharp/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- Shared package icon (128x128 PNG rasterized from website/public/orleans-fsharp-logo.svg).
         Same logo for all packages; packed in Directory.Build.targets (IsPackable-guarded). -->
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- Note: IsPackable-conditional ItemGroups belong in Directory.Build.targets,
       not here. .props is imported BEFORE individual project files, so a project
       that overrides <IsPackable>false</IsPackable> hasn't done so yet when this
       file is read — meaning conditioned ItemGroups would land in non-packable
       projects too. .targets is imported AFTER project files. See Directory.Build.targets. -->
</Project>
