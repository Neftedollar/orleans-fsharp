---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

interface Props {
  href: string;
  icon?: StarlightIcon;
  title: string;
}

const { href, icon, title } = Astro.props;
---

<a class="card feature-card sl-flex" {href}>
  <p class="title sl-flex">
    {icon && <Icon name={icon} class="icon" size="1.333em" />}
    <span set:html={title} />
    <span class="arrow" aria-hidden="true">→</span>
  </p>
  <div class="body"><slot /></div>
</a>

<style>
  .feature-card {
    --sl-card-border: var(--sl-color-purple);
    --sl-card-bg: var(--sl-color-purple-low);
    box-sizing: border-box;
    min-height: 100%;
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-black);
    padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
    flex-direction: column;
    gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
    color: inherit;
    text-decoration: none;
  }

  .feature-card:nth-child(4n + 1) {
    --sl-card-border: var(--sl-color-orange);
    --sl-card-bg: var(--sl-color-orange-low);
  }

  .feature-card:nth-child(4n + 3) {
    --sl-card-border: var(--sl-color-green);
    --sl-card-bg: var(--sl-color-green-low);
  }

  .feature-card:nth-child(4n + 4) {
    --sl-card-border: var(--sl-color-red);
    --sl-card-bg: var(--sl-color-red-low);
  }

  .feature-card:nth-child(4n + 5) {
    --sl-card-border: var(--sl-color-blue);
    --sl-card-bg: var(--sl-color-blue-low);
  }

  .title {
    margin: 0;
    align-items: center;
    gap: 1rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
  }

  .feature-card .icon {
    flex-shrink: 0;
    border: 1px solid var(--sl-card-border);
    border-radius: 0.25rem;
    padding: 0.2em;
    background-color: var(--sl-card-bg);
  }

  .body {
    margin: 0;
    font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
  }

  .arrow {
    margin-inline-start: auto;
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .feature-card:hover .arrow {
    color: var(--sl-color-white);
    transform: translateX(0.2rem);
  }

  .feature-card:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }

    .feature-card:hover .arrow {
      transform: none;
    }
  }
</style>
