<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Legacy Orleans.FSharp event-sourcing compatibility source. New applications use journaledGrainFor from Orleans.FSharp; this project is no longer packaged.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Legacy compatibility source: keep it buildable for examples and tests,
         but do not ship a new package in the 5.x production release. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
    <Compile Include="EventSourcedGrainBuilder.fs" />
    <Compile Include="EventStore.fs" />
    <Compile Include="EventSourcedHandlerRegistry.fs" />
    <Compile Include="EventSourcedGrainDiscovery.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.EventSourcing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.FSharp\Orleans.FSharp.fsproj" />
    <ProjectReference Include="..\Orleans.FSharp.Runtime\Orleans.FSharp.Runtime.fsproj" />
  </ItemGroup>

</Project>
