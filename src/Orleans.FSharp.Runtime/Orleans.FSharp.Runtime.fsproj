<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>F# computation expressions for configuring Orleans silos and clients — siloConfig {}, clientConfig {}, GrainDiscovery, and Serilog integration.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SiloConfigBuilder.fs" />
    <Compile Include="ClientConfigBuilder.fs" />
    <Compile Include="SerilogIntegration.fs" />
    <Compile Include="GrainDiscovery.fs" />
    <Compile Include="TransactionalGrainDiscovery.fs" />
    <Compile Include="FunctionalMarker.fs" />
    <Compile Include="FunctionalRegistry.fs" />
    <Compile Include="FunctionalManifest.fs" />
    <Compile Include="FunctionalState.fs" />
    <Compile Include="FunctionalJournal.fs" />
    <Compile Include="FunctionalDispatch.fs" />
    <Compile Include="FunctionalActivation.fs" />
    <Compile Include="FunctionalSiloHosting.fs" />
    <Compile Include="FunctionalScripting.fs" />
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <!-- SiloConfigBuilder names Orleans.Storage.MemoryGrainStorage unconditionally (both the
         AddMemoryGrainStorage calls and the manifest pre-load touch), so the dependency is
         declared here rather than ridden in transitively through Microsoft.Orleans.Server. -->
    <PackageReference Include="Microsoft.Orleans.Persistence.Memory" />
    <PackageReference Include="Microsoft.Orleans.Transactions" />
    <!-- Spec 004 item 3: the functional journaled kind drives Orleans' own log-view adaptors
         (ILogViewAdaptorFactory, ILogConsistencyProtocolServices) directly. -->
    <PackageReference Include="Microsoft.Orleans.EventSourcing" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="Microsoft.Orleans.BroadcastChannel" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.FSharp\Orleans.FSharp.fsproj" />
  </ItemGroup>

</Project>
