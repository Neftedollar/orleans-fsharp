<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>C# bridge project enabling Orleans Roslyn source generators for F# grain definitions. Add this project to your silo solution to generate proxy code for all F# grains — no per-grain C# stubs needed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Disable XML doc warnings for Orleans-generated serialization code -->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.EventSourcing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.FSharp.Abstractions\Orleans.FSharp.Abstractions.csproj" />
    <!-- Optional: add your grain project here to generate per-grain proxies (legacy pattern).
         In the new universal interface pattern, only Abstractions is needed. -->
    <ProjectReference Include="..\Orleans.FSharp.Sample\Orleans.FSharp.Sample.fsproj" />
    <!-- Pull the F# generator into this project's build graph so MSBuild builds it
         in a single coordinated pass. Without this, the Exec below spawns a sibling
         `dotnet run` that re-builds Orleans.FSharp transitively in parallel with the
         parent build, racing on Orleans.FSharp.deps.json. ReferenceOutputAssembly=false
         keeps the generator's DLL out of CodeGen's compile inputs. -->
    <ProjectReference Include="..\Orleans.FSharp.Generator\Orleans.FSharp.Generator.fsproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Exclude Generated/ from SDK auto-discovery — files are added dynamically by IncludeGeneratedStubs. -->
  <ItemGroup>
    <Compile Remove="Generated\**" />
  </ItemGroup>

  <!-- Step 1: Run the F# generator to emit *.g.cs files into Generated/.
       Orleans.FSharp.Sample is already built via ProjectReference above, so its DLL exists. -->
  <!-- BeforeTargets=CoreCompile + DependsOnTargets=ResolveProjectReferences:
       BeforeBuild fires too early on Linux parallel builds — ProjectReference output
       assemblies (Sample.dll) aren't placed in bin/ yet when BeforeBuild runs, even
       though the references are listed. Moving to CoreCompile guarantees all
       ProjectReference outputs are available before the generator is invoked. -->
  <Target Name="RunFSharpGrainGenerator"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences">
    <!-- Ask each referenced project for its ACTUAL TargetPath instead of guessing a
         bin/<Configuration>/ path. Guessed paths break whenever the referenced project's
         effective Configuration differs from this project's: MSBuild unsets Configuration
         for a ProjectReference that is not a member of the solution being built, so the
         same reference lands in bin/Debug under one solution and bin/Release under another
         (Orleans.FSharp.slnx and testbed/Testbed.slnx now list Sample and Generator as
         members precisely so these calls and the actual build agree). The GetTargetPath
         call inherits this project's global properties, matching the in-solution case;
         the Exists preflight below turns the out-of-solution mismatch into an actionable
         error instead of a missing-file mystery. -->
    <!-- An explicit Build call precedes each GetTargetPath, because GetTargetPath only ANSWERS
         with the path and never builds — and on a cold parallel solution build this target can
         fire before the scheduler has built Generator/Sample on another node, failing the
         Exists preflight below (first seen on the v4.0.0 publish job, whose runner had no warm
         bin/ to mask the race; reproduced locally with a cold Release build). MSBuild's result
         cache makes the Build call a no-op when the solution build already produced the project
         on this or another node. Build and GetTargetPath are SEPARATE invocations: one call with
         Targets="Build;GetTargetPath" would aggregate both targets' outputs into the property
         ("path;path"), which the Exists preflight would then reject. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Orleans.FSharp.Generator\Orleans.FSharp.Generator.fsproj"
             Targets="Build" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Orleans.FSharp.Sample\Orleans.FSharp.Sample.fsproj"
             Targets="Build" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Orleans.FSharp.Generator\Orleans.FSharp.Generator.fsproj"
             Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_GeneratorAssembly" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Orleans.FSharp.Sample\Orleans.FSharp.Sample.fsproj"
             Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_SampleAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_GeneratedDir>$(MSBuildThisFileDirectory)Generated\</_GeneratedDir>
    </PropertyGroup>
    <Error Text="Generator assembly not found at '$(_GeneratorAssembly)'. If this project is being built as part of a solution, that solution must also list Orleans.FSharp.Generator and Orleans.FSharp.Sample as members — MSBuild unsets Configuration for out-of-solution project references, so their build output lands in a different bin/ than this resolution expects."
           Condition=" !Exists('$(_GeneratorAssembly)') " />
    <Error Text="Sample assembly not found at '$(_SampleAssembly)'. If this project is being built as part of a solution, that solution must also list Orleans.FSharp.Generator and Orleans.FSharp.Sample as members — MSBuild unsets Configuration for out-of-solution project references, so their build output lands in a different bin/ than this resolution expects."
           Condition=" !Exists('$(_SampleAssembly)') " />
    <MakeDir Directories="$(_GeneratedDir)" />
    <!-- Invoke the pre-built generator DLL via `dotnet exec`, NOT `dotnet run`.
         `dotnet run` spawns a separate MSBuild process that re-builds the Generator's
         dependency graph (Generator → EventSourcing → Orleans.FSharp). When the parent
         build also depends on Orleans.FSharp (e.g. `dotnet test` on Integration), both
         processes race on the same files and one deadlocks. Generator is wired in as a
         ProjectReference above with ReferenceOutputAssembly=false, so the Generator DLL
         is guaranteed to exist by the time this target fires (DependsOnTargets ensures
         that). `dotnet exec` simply runs it.

         ConsoleToMSBuild + IgnoreExitCode: capture the generator's stdout/stderr so we
         can print it via <Message Importance="High"> regardless of whether the generator
         succeeded or failed. Without this, MSBuild Exec output flows at "Low" importance
         and is filtered out at the default verbosity normal, leaving CI logs with only
         a bare MSB3073 wrapper on failure. The conditional <Error> after printing fails
         the build for non-zero exit codes, preserving the original failure semantics. -->
    <Exec Command="dotnet exec &quot;$(_GeneratorAssembly)&quot; --assembly &quot;$(_SampleAssembly)&quot; --output &quot;$(_GeneratedDir)&quot; --namespace Orleans.FSharp.CodeGen"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_GeneratorOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GeneratorExitCode" />
    </Exec>
    <Message Text="%(_GeneratorOutput.Identity)" Importance="High" />
    <Error Text="Orleans.FSharp.Generator failed with exit code $(_GeneratorExitCode)"
           Condition=" '$(_GeneratorExitCode)' != '0' " />
  </Target>

  <!-- Step 2: Add the generated files to the Compile ItemGroup AFTER they exist.
       BeforeTargets="CoreCompile" ensures the C# compiler sees them. -->
  <Target Name="IncludeGeneratedStubs" AfterTargets="RunFSharpGrainGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(MSBuildThisFileDirectory)Generated\*.g.cs" />
    </ItemGroup>
  </Target>

</Project>
