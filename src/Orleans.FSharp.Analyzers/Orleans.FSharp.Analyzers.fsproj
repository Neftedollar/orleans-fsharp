<Project Sdk="Microsoft.NET.Sdk">

  <!-- Analyzers must target a runtime the build host can load; net8.0 covers all modern .NET hosts. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Orleans.FSharp.Analyzers</AssemblyName>
    <Description>FSharp.Analyzers.SDK CLI analyzer for Orleans.FSharp — task-based grain code feedback.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AsyncUsageAnalyzer.fs" />
    <Compile Include="AssemblyInfo.fs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- FSharp.Analyzers.SDK 0.37.2 pins FSharp.Core 10.0.101; suppress NU1608 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Analyzers.SDK" />
  </ItemGroup>

</Project>
