<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>C# interface definitions and Orleans proxy generation for Orleans.FSharp universal grain interfaces. Reference this package from your silo to enable all F# grains without any per-grain C# stubs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixed functional transport (envelope, request, reply, dispatch target, marker) is
         internal: only IFunctionalRequestMetadata and FunctionalGrainTransportOptions are part
         of the application surface. The upper layers and the test projects need the internals. -->
    <InternalsVisibleTo Include="Orleans.FSharp" />
    <InternalsVisibleTo Include="Orleans.FSharp.Runtime" />
    <InternalsVisibleTo Include="Orleans.FSharp.Tests" />
    <InternalsVisibleTo Include="Orleans.FSharp.Integration" />
  </ItemGroup>

  <ItemGroup>
    <!-- Orleans.Sdk brings in source generators that produce Proxy_IFSharpGrain* classes
         and the Metadata manifest — all within this assembly, no cross-assembly access issues. -->
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <!-- Spec 004 item 2: FunctionalTransactionRequest derives from Orleans'
         TransactionRequest<TResult>, which lives here along with the transaction agent,
         TransactionContext, and the generated IBaseCodec<TransactionRequestBase> the
         transactional request's codec delegates its base segment to. -->
    <PackageReference Include="Microsoft.Orleans.Transactions" />
    <!-- JournaledGrain base class for FSharpEventSourcedGrainImpl. -->
    <PackageReference Include="Microsoft.Orleans.EventSourcing" />
  </ItemGroup>

</Project>
