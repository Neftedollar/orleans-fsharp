<Solution>
  <Folder Name="/src/">
    <Project Path="src/Client/Client.fsproj" />
    <Project Path="src/Shared/Shared.fsproj" />
    <Project Path="src/Silo/Silo.fsproj" />
  </Folder>
  <Project Path="../src/Orleans.FSharp.Runtime/Orleans.FSharp.Runtime.fsproj" />
  <Project Path="../src/Orleans.FSharp/Orleans.FSharp.fsproj" />
  <Project Path="../src/Orleans.FSharp.CodeGen/Orleans.FSharp.CodeGen.csproj" />
  <!-- CodeGen's build target runs the Generator against the built Sample assembly. Both must
       be solution members: during a solution build MSBuild unsets Configuration for a
       ProjectReference that is not in the solution, so without these two entries a Release
       build sends them to bin/Debug while CodeGen looks under bin/Release and fails. -->
  <Project Path="../src/Orleans.FSharp.Sample/Orleans.FSharp.Sample.fsproj" />
  <Project Path="../src/Orleans.FSharp.Generator/Orleans.FSharp.Generator.fsproj" />
</Solution>
