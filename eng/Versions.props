<Project>
  <PropertyGroup>
    <!-- The minimum Orleans version is shared by package resolution and build-output isolation.
         A command-line -p:OrleansVersion=... remains a global property and wins over this default. -->
    <OrleansVersion Condition="'$(OrleansVersion)' == ''">10.1.0</OrleansVersion>
    <OrleansSharedVersionsImported>true</OrleansSharedVersionsImported>
  </PropertyGroup>
</Project>
