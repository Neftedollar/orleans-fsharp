<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Task 8 deprecation pass (ruling 6): this example keeps its grain{} demos running
         beside their functional-runtime twin (UserGrainFunctional.fs) on purpose. -->
    <NoWarn>$(NoWarn);FS0044</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ids.fs" />
    <Compile Include="Routing.fs" />
    <Compile Include="UserGrain.fs" />
    <Compile Include="UserGrainFunctional.fs" />
    <Compile Include="OrderGrain.fs" />
    <Compile Include="RouterGrain.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/Orleans.FSharp/Orleans.FSharp.fsproj" />
  </ItemGroup>

</Project>
