<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The tour is a NEW-API showcase: nothing here touches the deprecated grain { } cluster,
         so there is deliberately no FS0044 suppression (unlike the sibling examples, which keep
         a classic twin alive on purpose). -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tour.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="Scheduling.fs" />
    <Compile Include="CallFilters.fs" />
    <Compile Include="RequestContextTour.fs" />
    <Compile Include="Cancellation.fs" />
    <Compile Include="VersioningTour.fs" />
    <Compile Include="Streams.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/Orleans.FSharp/Orleans.FSharp.fsproj" />
    <ProjectReference Include="../../../../src/Orleans.FSharp.Runtime/Orleans.FSharp.Runtime.fsproj" />
  </ItemGroup>

</Project>
